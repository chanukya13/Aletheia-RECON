# Local workbench: npm run start (no secrets or hosted configuration needed).
# Hosted Node service: npm run start:hosted
# Render supplies PORT and RENDER_EXTERNAL_URL automatically.
PORT=10000
RECON_PUBLIC_ORIGIN=https://your-service.onrender.com
RECON_DATA_DIR=/var/data/recon
# Use temporary with RECON_DATA_DIR=/tmp/recon on free ephemeral hosting.
RECON_STORAGE_MODE=persistent
RECON_LIVE_TAXONOMY=1
